<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
    </parent>
    <groupId>cn.ontorepo</groupId>
    <artifactId>ontorepo</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <properties>
        <java.version>21</java.version>
        <commons-lang3.version>3.19.0</commons-lang3.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- Jena/Hadoop的旧传递版本不能覆盖CSV/POI要求的构建器API。 -->
            <dependency><groupId>commons-io</groupId><artifactId>commons-io</artifactId><version>2.20.0</version></dependency>
        </dependencies>
    </dependencyManagement>
    <modules>
        <module>onto-contract</module>
        <module>onto-artifact</module>
        <module>onto-data</module>
        <module>onto-common</module>
        <module>onto-space</module>
        <module>onto-model</module>
        <module>onto-operation</module>
        <module>onto-mapping</module>
        <module>onto-ingest</module>
        <module>onto-knowledge</module>
        <module>onto-trace</module>
        <module>onto-release</module>
        <module>onto-designer-api</module>
    </modules>
</project>
