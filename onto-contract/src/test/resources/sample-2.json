{"tool_code":"task_used_algorithms","name":"查询任务使用的算法",
 "description":"按任务标识返回其使用的算法对象及关系证据",
 "invocation_kind":"SYNC","adapter_type":"HTTP","category":"ontology_service",
 "endpoint":"https://onto.example.com/onto/r/sp_001/releases/rel_001/ops/task_used_algorithms",
 "http_method":"POST",
 "input_schema":{"type":"object","required":["taskId"],"properties":{"taskId":{"type":"string","maxLength":64}}},
 "output_schema":{"type":"object","required":["code","data","meta"],
   "properties":{"code":{"const":"OK"},
     "data":{"type":"object","required":["stdCode"],
             "properties":{"stdCode":{"type":"string"},"algoName":{"type":"string"},"evidence":{"type":"object"}}},
     "meta":{"type":"object","required":["spaceCode","releaseId","version","contentDigest"],
             "properties":{"spaceCode":{"type":"string"},"releaseId":{"type":"string"},
                           "version":{"type":"string"},"contentDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}},
 "guard_attrs":["region","tenant_label"],
 "exec_attrs":{"readonly_flag":true,"side_effect":false,"idempotent":true,"cancellable":true,"timeout_ms":5000,"max_rows":200},
 "risk_level":"READ_ONLY",
 "error_semantics":[{"match":"HTTP 403","semantic":"NO_PERMISSION"},{"match":"HTTP 404","semantic":"PARAM_ERROR"}],
 "return_spec":{"modelSummary":{"mode":"TEMPLATE","template":"任务 ${taskId} 使用算法 ${stdCode}"},
                "structuredPath":"$.data","fileRefPaths":[],"cardTemplate":"算法 ${stdCode}","ontologyMetaPath":"$.meta"},
 "ontology_meta":{"spaceCode":"sp_001","releaseId":"rel_001","version":"3","contentDigest":"9f2c8a6d4e1b7c3f5a9d0e2b4c6f8a1d3e5f7b9c1d3f5a7b9c1e3f5a7b9d0e2b"}}
